activation	Interpolate variables and render templates	2026-10-28T04:26:11.7417635Z   GH_AW_STEPS_PREPARE_OUTPUTS_ISSUE: {"title": "v2.0.0-dev84858: Vector::Reference used on vector of different type (source INTEGER[] referenced INTEGER)", "body": "### What happens?\n\nWe see this internal error with latest v2.0-cyanoptera. I didn't see a similar report.\n\n### To Reproduce\n\n```sql\nCREATE TABLE t1 (c1 INTEGER, c2 INTEGER[]);\nINSERT INTO t1 VALUES (1, NULL), (2, NULL);\n\nUPDATE t1 SET c2 = s3.a1\nFROM (\n    SELECT t1.c1                   AS a0,\n           max(s1.v1)              AS a1,\n           max(t1.c1)::BIGINT      AS a2,\n           count(DISTINCT t1.c1)   AS a3\n    FROM t1\n    JOIN (SELECT c1 AS k1, [c1] AS v1 FROM t1) AS s1 ON (t1.c1 = s1.k1)\n    JOIN (SELECT DISTINCT c1 FROM t1)          AS s2 ON (t1.c1 = s2.c1)\n    GROUP BY t1.c1\n) AS s3\nWHERE t1.c1 = s3.a0;\n\n```\n\n```\nINTERNAL Error:\nVector::Reference used on vector of different type (source INTEGER[] referenced INTEGER)\n\nStack Trace:\n\n0        duckdb::Exception::ToJSON(duckdb::ExceptionType, std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char>> const&) + 420\n1        duckdb::Exception::Exception(duckdb::ExceptionType, std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char>> const&) + 468\n2        duckdb::InternalException::InternalException(std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char>> const&) + 220\n3        duckdb::InternalException::InternalException(std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char>> const&) + 84\n4        duckdb::InternalException::InternalException<duckdb::LogicalType const&, duckdb::LogicalType const&>(std::__1::basic_string<char, std::__1::char_traits<char>, std::__1::allocator<char>> const&, duckdb::LogicalType const&, duckdb::LogicalType const&) + 580\n5        duckdb::Vector::Reference(duckdb::Vector const&) + 852\n6        duckdb::ExpressionExecutor::Execute(duckdb::BoundReferenceExpression const&, duckdb::ExpressionState*, duckdb::SelectionVector const*, unsigned long long, duckdb::Vector&) + 1060\n7        duckdb::ExpressionExecutor::Execute(duckdb::Expression const&, duckdb::ExpressionState*, duckdb::SelectionVector const*, unsigned long long, duckdb::Vector&) + 2292\n8        duckdb::ExpressionExecutor::ExecuteExpression(unsigned long long, duckdb::Vector&) + 1456\n9        duckdb::ExpressionExecutor::Execute(duckdb::DataChunk*, duckdb::DataChunk&) + 652\n10       duckdb::ExpressionExecutor::Execute(duckdb::DataChunk&, duckdb::DataChunk&) + 152\n11       duckdb::PhysicalProjection::Execute(duckdb::ExecutionContext&, duckdb::DataChunk&, duckdb::DataChunk&, duckdb::GlobalOperatorState&, duckdb::OperatorState&) const + 372\n12       duckdb::PipelineExecutor::Execute(duckdb::DataChunk&, duckdb::DataChunk&, unsigned long long) + 2756\n13       duckdb::PipelineExecutor::ExecutePushInternal(duckdb::DataChunk&, duckdb::ExecutionBudget&, unsigned long long) + 1128\n14       duckdb::PipelineExecutor::PushInputChunk(duckdb::DataChunk&, duckdb::ExecutionBudget&, duckdb::PipelineExecutor::PipelineInputChunkMode) + 968\n15       duckdb::PipelineExecutor::PushExternal(duckdb::DataChunk&, duckdb::OperatorPartitionData const&, duckdb::optional_idx) + 1952\n16       duckdb::PipelineBroadcastExchangeLocalState::Push(duckdb::DataChunk&, duckdb::SourcePartitionInfo const&, duckdb::InterruptState const&) + 2100\n17       duckdb::PipelineBroadcastExchange::Push(duckdb::DataChunk&, duckdb::PipelineBroadcastExchangeLocalState&, duckdb::SourcePartitionInfo const&, duckdb::InterruptState const&) + 652\n18       duckdb::PhysicalCTE::Sink(duckdb::ExecutionContext&, duckdb::DataChunk&, duckdb::OperatorSinkInput&) const + 1960\n19       duckdb::PipelineExecutor::Sink(duckdb::DataChunk&, duckdb::OperatorSinkInput&) + 560\n20       duckdb::PipelineExecutor::ExecutePushInternal(duckdb::DataChunk&, duckdb::Execution